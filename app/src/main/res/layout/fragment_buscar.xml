<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="BÚSQUEDA DE PELÍCULAS"
            android:layout_marginBottom="10dp"
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtIdM"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="Id"
                android:inputType="number"
                android:padding="14dp"/>

            <Button
                android:id="@+id/btnBuscarM"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:layout_weight="1"
                android:padding="14dp"
                android:text="Buscar"/>

        </LinearLayout>

        <EditText
            android:id="@+id/edtTituloM"
            android:hint="Título"
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edtDuracionM"
            android:hint="Duración (minutos)"
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Género:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgGenero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <RadioButton
                android:id="@+id/rbtAnimadoM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Animado"/>

            <RadioButton
                android:id="@+id/rbtDramaM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drama"/>

            <RadioButton
                android:id="@+id/rbtComediaM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comedia"/>

            <RadioButton
                android:id="@+id/rbtAccionM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acción"/>

            <RadioButton
                android:id="@+id/rbtTerrorM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terror"/>

        </RadioGroup>

        <EditText
            android:id="@+id/edtALanzamientoM"
            android:hint="Año de Lanzamiento"
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnActualizarPeliculaM"
            android:text="Actualizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

</ScrollView>


